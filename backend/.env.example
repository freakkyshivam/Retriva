# Server Port
PORT=3000

# Qdrant Vector Cloud Database
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Groq LLM (RAG answer synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Access Control (Set a password to protect public deployment quotas)
ACCESS_PASSWORD=your_secret_access_passcode
