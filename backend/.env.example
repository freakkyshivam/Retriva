# Server Port
PORT=3000

# Qdrant Vector Cloud Database
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Groq LLM (RAG answer synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Rate Limiting (Configurable thresholds per IP)
RATE_LIMIT_SEARCH_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000

RATE_LIMIT_ASK_MAX=10
RATE_LIMIT_ASK_WINDOW_MS=60000

RATE_LIMIT_AUTOCOMPLETE_MAX=60
RATE_LIMIT_AUTOCOMPLETE_WINDOW_MS=60000

RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# Redis & RAG Response Caching
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=86400

# Input Validation & Resource Limits
MAX_SEARCH_QUERY_LENGTH=500
MAX_QUESTION_LENGTH=1000
MAX_AUTOCOMPLETE_QUERY_LENGTH=100
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=20000
JSON_BODY_LIMIT=10kb
ALLOWED_ORIGINS=http://localhost:5173


